pipeline{
    agent {
        label 'worker'
    }
    tools {
        maven 'mvn'
    }
    stages {
        stage('Checkout'){
            steps {
                git branch: 'main', credentialsId: 'github-cred', url: 'https://github.com/mayurpandit25/EasyCRUD.git'
            }
        }
        stage('Build') {
            steps {
                dir('backend') {
                    sh 'mvn clean package'
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: 'backend/target/*.jar' , fingerprint:true
                }
            }
        }
}