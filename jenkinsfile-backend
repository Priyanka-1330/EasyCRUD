pipeline {
    agent {
        label 'worker'
    }
    tools {
        maven 'mvn'
    }
    environment {
        my_aws_cred =credentials('access-key')
        
    }
    stages {
        stage('Checkout'){
            steps {
                git branch: 'main', credentialsId: 'github-cred', url: 'https://github.com/mayurpandit25/EasyCRUD.git'
            }
        }
        stage('Build') {
            steps {
                dir('backend') {
                    sh 'mvn clean package'
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: 'backend/target/*.jar' , fingerprint:true
                }
            }
        }
        stage('Artifact to s3') {
            steps{
                sh '''
                    sudo snap install aws-cli --classic
                    aws s3 cp backend/target/*.jar s3://easy-curd-priyanka/Artifact/student.war
                '''
            }

        }
        stage('sonarQube Analisis') {
            steps{
                dir('backend'){
                    withSonarQubeEnv('sonar'){
                        sh 'mvn sonar:sonar'
                    }
                }
            }
        }
        stage('Quality Gates') {
            steps {
                timeout(time: 5, unit: 'MINUTES'){
                    waitForQualityGate abortPipeline: true
                }
            }
        }
        stage('Docker Build'){
            steps{
                dir('backend'){
                    sh '''
                      docker build -t backend:${BUILD_NUMBER} 
                    '''
                }
            }
        }
    }
}